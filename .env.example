# ADHD Budget Assistant — Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Enable Banking Configuration (Production / Restricted)
# ===========================================
# Register at https://enablebanking.com to get your credentials
ENABLE_APP_ID=your-enable-banking-app-id
ENABLE_PRIVATE_KEY_PATH=./keys/enablebanking_private.pem
ENABLE_API_BASE_URL=https://api.enablebanking.com

# ===========================================
# Server & MCP Configuration
# ===========================================
PORT=8081
HOST=0.0.0.0
EXTERNAL_URL=https://adhdbudget.bieda.it
DATA_DIR=./data

# Static Bearer Token for CLI & Desktop AI clients (Claude Code, Kimi Desktop, Odysseus Web)
MCP_TOKEN=adhd_budget_secret_token_change_me_2026

# Optional: allow any HTTPS client redirect URI during dynamic client registration
ALLOW_ALL_REDIRECTS=false